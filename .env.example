# ---------------------------------------------------------------------------
# Database (PostgreSQL + Prisma)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/codepulse?schema=public"

# ---------------------------------------------------------------------------
# Redis (BullMQ background jobs)
# ---------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ---------------------------------------------------------------------------
# AI Providers (Vercel AI SDK) - optional. Leave both empty to use the
# deterministic mock insight generator (src/server/ai/client.ts) so the
# analyze-repo-queue pipeline still works end-to-end without credentials.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""
# "openai" | "anthropic" | "google"
AI_PROVIDER="openai"
# Examples: gpt-4o | claude-3-5-sonnet-latest | gemini-1.5-flash-8b | gemini-2.0-flash
AI_MODEL="gpt-4o"

# ---------------------------------------------------------------------------
# GitHub integration
# ---------------------------------------------------------------------------
GITHUB_TOKEN=""
# Opcional: habilita login con GitHub y listado de repos del usuario en el modal
# "Conectar repositorio". Sin estas variables, la app usa entrada manual de URL.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Opcional. Secret de plataforma (fallback). En la app multi-tenant cada
# organización usa su propio secret (cp_wh_...) desde Settings → Webhook GitHub.
GITHUB_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# App / Auth.js
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-with-a-random-string"
NEXTAUTH_SECRET="replace-with-a-random-string"
# Required on Vercel so Auth.js trusts the deployment host.
AUTH_TRUST_HOST="true"
# Public URL of the deployed app (no trailing slash)
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
